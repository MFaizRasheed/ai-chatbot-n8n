# App
APP_NAME=AI Chatbot
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# LLM provider: groq | gemini | openrouter
LLM_PROVIDER=groq
# Optional: override the default model for the provider
# LLM_MODEL=
# Comma-separated fallback providers tried in order when the primary fails
# LLM_FALLBACK_PROVIDERS=gemini,openrouter

# API keys — put real values in your local .env, never commit them
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Gmail account used by the email-sending tool (App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional second sender account
# GMAIL_USER_2=
# GMAIL_APP_PASSWORD_2=
